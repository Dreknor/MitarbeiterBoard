{
    "name": "dreknor/mitarbeiterboard",
    "type": "project",
    "description": "MitarbeiterBoard des ESZ Radebeul",
    "keywords": [
        "school",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "aacotroneo/laravel-saml2": "^2.1",
        "barryvdh/laravel-dompdf": "^3.1",
        "barryvdh/laravel-snappy": "^1.0.5",
        "composer/composer": "^2.10.3",
        "danielme85/laravel-log-to-db": "^5.0",
        "dyrynda/laravel-cascade-soft-deletes": "^4.4",
        "ezyang/htmlpurifier": "^4.19",
        "guzzlehttp/guzzle": "^7.15.2",
        "h4cc/wkhtmltopdf-amd64": "^0.12.4",
        "laravel-notification-channels/webpush": "^10.5",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^10.11",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.6",
        "laravie/parser": "^3.0",
        "livewire/livewire": "^4.4.8",
        "maatwebsite/excel": "^3.1.70",
        "owen-it/laravel-auditing": "^14.0",
        "phpoffice/phpword": "^1.0",
        "ryangjchandler/blade-cache-directive": "^1.0",
        "sabre/vobject": "4.5",
        "sentry/sentry-laravel": "^4.0",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "socialiteproviders/keycloak": "^5.3",
        "socialiteproviders/zoho": "^4.1",
        "spatie/image": "^3.9",
        "spatie/laravel-google-calendar": "^3.8",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-permission": "^6.0",
        "staudenmeir/belongs-to-through": "^2.16",
        "staudenmeir/eloquent-has-many-deep": "^1.21"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.15",
        "fakerphp/faker": "^1.9.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.9"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": "php artisan test",
        "test:coverage": "php artisan test --coverage-html=storage/coverage"
    }
}
